# ==============================================================================
# ASISTENTE EIT UDP - VARIABLES DE ENTORNO (PLANTILLA)
# ==============================================================================
# Copia este archivo a `.env` (o `.env.local`) y completa los valores correspondientes.
# NUNCA subas archivos `.env` con credenciales reales al repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PROVEEDOR DE INTELIGENCIA ARTIFICIAL ("ollama" | "gemini")
# ------------------------------------------------------------------------------
# En Dokku (Producción UDP): AI_PROVIDER="ollama"

# ⚠️ CAMBIAR AI_PROVIDER CAMBIA EL ESPACIO VECTORIAL COMPLETO.
# Cada proveedor usa un modelo de embeddings distinto, con distinta
# dimensionalidad y distinta columna en eit_docs:
#   ollama -> bge-m3            1024 dims -> columna embedding_1024 -> buscar_docs_v2
#   gemini -> text-embedding-004 768 dims -> columna embedding      -> buscar_docs
# Los vectores de un proveedor NO son comparables con los del otro. Si cambias de
# proveedor tienes que correr `npm run scrape` completo para repoblar el corpus
# de ese espacio; si no, la búsqueda devuelve CERO resultados y el asistente
# se abstiene de generar una respuesta por falta de documentos.
# En Vercel (Demo pública): AI_PROVIDER="gemini"
AI_PROVIDER="ollama"

# Contención de respuestas: guarded = RAG con admisión y validación de salida.
# static = solo mensajes fijos, sin embeddings, reescritura, generación ni
# analítica remota desde el chat. Valores desconocidos también desactivan IA.
# Si se omite, se conserva guarded. Aplicar en el servidor y reiniciar procesos.
CHAT_RESPONSE_MODE="guarded"

# Configuración Ollama (On-Premise GPU)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_EMBED_MODEL="bge-m3"
EMBED_DIM="1024"

# Configuración Google Gemini (Opcional / Demo Vercel)
GEMINI_API_KEY="tu_gemini_api_key_aqui"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBED_MODEL="text-embedding-004"

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS VECTORIAL (SUPABASE) [OBLIGATORIO]
# ------------------------------------------------------------------------------
# URL del proyecto Supabase (ej: https://xxxxxx.supabase.co)
SUPABASE_URL="https://tu-proyecto.supabase.co"

# Service Role Key de Supabase (requerida para operaciones de RAG, vector search,
# inserción de feedback y scraper de documentos).
SUPABASE_SERVICE_KEY="tu_supabase_service_role_key_aqui"

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y PANEL ADMINISTRATIVO [OBLIGATORIO]
# ------------------------------------------------------------------------------
# Contraseña para acceder a /admin
ADMIN_PASSWORD="cambiar_por_un_password_seguro"

# Secreto aleatorio para firmar las cookies de sesión (mínimo 32 caracteres)
ADMIN_SESSION_SECRET="generar_un_secreto_aleatorio_seguro_de_al_menos_32_chars"

# Token secreto para autorizar el endpoint de cron (/api/cron-scrape)
CRON_SECRET="generar_un_token_secreto_para_el_cron"

# Genera cada secreto por separado (nunca reutilices uno en otro campo):
#   openssl rand -base64 48
# ADMIN_SESSION_SECRET y CRON_SECRET exigen 32+ caracteres; con menos, el panel y el
# cron se niegan a funcionar (fail-closed). ADMIN_PASSWORD: 12+ caracteres y al
# menos tres de: minúsculas, mayúsculas, dígitos, símbolos.

# Redirige http → https (308) cuando el proxy envía X-Forwarded-Proto: http.
# Activar SOLO tras confirmar que el proxy que termina TLS fija ese header;
# si no, provoca un bucle de redirecciones.
# FORCE_HTTPS=true

# Resolución de la IP del cliente para rate limiting (api/_lib/rate-limit.js).
# Las cabeceras de proxy SOLO se aceptan si la conexión viene de estas redes.
# Por defecto: loopback + redes privadas (Nginx de Dokku conecta desde Docker).
# Si la app quedara expuesta directamente a una red privada de usuarios,
# restringe esto a la IP del proxy (ej. 172.17.0.1/32) o usa "none".
# TRUSTED_PROXY_CIDRS=172.17.0.0/16
# Proxies encadenados delante de la app que agregan X-Forwarded-For (1 = solo Nginx).
# TRUSTED_PROXY_HOPS=1
# Cabecera alternativa que el proxy SIEMPRE reescribe (ej. x-real-ip solo si
# Nginx tiene `proxy_set_header X-Real-IP $remote_addr`). Vacío = X-Forwarded-For.
# TRUSTED_IP_HEADER=

# Generaciones simultáneas: total contra la GPU y por cliente.
# MAX_CONCURRENT_CHATS=4
# MAX_CONCURRENT_CHATS_PER_CLIENT=2

# ------------------------------------------------------------------------------
# 4. RECUPERACIÓN, INGESTA Y RETENCIÓN
# ------------------------------------------------------------------------------
# Búsqueda híbrida (semántica + texto completo con RRF). Requiere la migración
# scripts/migrations/005_busqueda_hibrida.sql; sin ella se usa solo la semántica.
# HYBRID_SEARCH=true

# Solo en la VM de ingesta: carpeta donde guardar el HTML de cada versión nueva.
# SCRAPE_SNAPSHOT_DIR=/var/lib/asistente-eit/snapshots

# Días que se conservan preguntas y feedback de estudiantes (mínimo 30).
# Ver docs/privacidad-y-retencion.md. Lo aplica scripts/purge-old-data.js.
# DATA_RETENTION_DAYS=180
